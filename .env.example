# ─── Radio Araucana / La Frontera — variables de entorno ───────────────────
# Copia este archivo a .env.local para desarrollo y pega los valores reales.
# En producción se configuran desde el dashboard de Vercel (Project Settings).
# Este archivo refleja SOLO variables que el código lee de verdad (grep de
# process.env / import.meta.env) — si agregas una nueva, documéntala acá.

# ─── Supabase (BD + Auth) ───────────────────────────────────────────────────
# https://supabase.com → Settings → API Keys.
# Server-side (bypass RLS — secreta). El código también acepta el nombre
# legacy SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Browser-side (RLS aplicada — pública):
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Opcional: timeout en ms de cada request server-side a Supabase (default 6000).
# SUPABASE_FETCH_TIMEOUT_MS=6000

# ─── Email transaccional — Resend vía SMTP ──────────────────────────────────
# Resend se consume por SMTP (no por API key): smtp.resend.com, user "resend",
# pass = API key de https://resend.com → API Keys. Dominio verificado SPF/DKIM.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
EMAIL_FROM=noreply@radioaraucana.cl
EMAIL_FROM_NAME="Radio La Frontera"
# Reply-To de los emails de extractos (casilla que sí lee la operadora):
GMAIL_USER=

# ─── Notificaciones internas (extractos) ────────────────────────────────────
# Lista separada por comas de destinatarios de las alertas de nuevas órdenes.
ADMIN_NOTIFICATION_EMAILS=

# ─── Cotizador /cotiza (Araucana FM) ────────────────────────────────────────
COTIZA_NOTIFICATION_TO=
COTIZA_NOTIFICATION_CC=
COTIZA_EMAIL_FROM=

# ─── Formulario /contacto ───────────────────────────────────────────────────
# JSON de ruteo por tema (ver api/contacto/submit.js) y remitente.
CONTACTO_RUTEO_JSON=
CONTACTO_EMAIL_FROM=

# ─── Panel de contenido /admin (home) ───────────────────────────────────────
# Clave del editor de contenido del sitio (api/admin/save.js, upload.js).
ADMIN_PASSWORD=

# ─── Acceso privado a la presentación de inversión (/propuesta) ─────────────
# Clave compartida que se pide para ver la presentación "Araucana Digital".
# Si queda vacía, /propuesta responde "acceso no configurado".
PROPUESTA_PASSWORD=

# ─── Cron de keepalive (/api/keepalive) ─────────────────────────────────────
# Opcional. Si se define, Vercel manda "Authorization: Bearer <CRON_SECRET>"
# en sus crons y el endpoint lo exige. Crear también el secret CRON_SECRET en
# GitHub Actions con el mismo valor (workflow supabase-keepalive.yml).
# CRON_SECRET=

# ─── Pasarela de pago — Flow.cl ─────────────────────────────────────────────
# NO IMPLEMENTADO AÚN: ningún código lee estas variables hoy. Se dejan
# documentadas para cuando se integre el pago online.
# FLOW_API_KEY=
# FLOW_SECRET_KEY=
# FLOW_BASE_URL=https://sandbox.flow.cl/api
