# ─── Sistema de Extractos Radiales — variables de entorno ──────────────────
# Copia este archivo a .env.local para desarrollo y pega los valores reales.
# En producción se configuran desde el dashboard de Vercel (Project Settings).

# ─── Supabase (BD + Auth + Storage) ────────────────────────────────────────
# Crear proyecto en https://supabase.com → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Las dos siguientes son las que el browser puede ver (anon, public):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Pasarela de pago — Flow.cl (sandbox) ──────────────────────────────────
# https://www.flow.cl/app/web/integracionTest.php
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_BASE_URL=https://sandbox.flow.cl/api
# URL absoluta de retorno tras pago (Vercel ya conoce el dominio):
FLOW_RETURN_URL=https://radioaraucana.cl/frontera/extractos/orden
FLOW_CONFIRMATION_URL=https://radioaraucana.cl/api/extractos/payments/webhook

# ─── Email transaccional — Resend ──────────────────────────────────────────
# https://resend.com → API Keys. Verificar dominio radioaraucana.cl con SPF/DKIM.
RESEND_API_KEY=
EMAIL_FROM="Radio La Frontera <noreply@radioaraucana.cl>"
EMAIL_REPLY_TO=secretaria.araucana@gmail.com

# ─── Notificaciones internas ───────────────────────────────────────────────
ADMIN_NOTIFICATION_EMAILS=secretaria.araucana@gmail.com
